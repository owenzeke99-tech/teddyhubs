local CorrectKey = "TeddyHubKeyLaiwowhLapwownneoakLahwowi"
local KeyLink = "https://link4m.net/sKQhz0Y5"
local SaveFileName = "TeddyHub_SavedKey.json"

-- Roblox Services
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

-- Platform utilities
local SetClipboard = setclipboard or syn_clip_set or toclipboard
local WriteFile = writefile or writeFile
local ReadFile = readfile or readFile
local IsFile = isfile or isFile

----------------------------------------------------
-- SYSTEM: AUTOMATIC 24-HOUR KEY SAVING CHECK
----------------------------------------------------
local function IsKeySavedValid()
    if IsFile and ReadFile and IsFile(SaveFileName) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(ReadFile(SaveFileName))
        end)
        
        if success and type(result) == "table" then
            if result.Key == CorrectKey and result.ExpireTime and os.time() < result.ExpireTime then
                return true
            end
        end
    end
    return false
end

local function SaveKeyData()
    if WriteFile then
        local data = {
            Key = CorrectKey,
            ExpireTime = os.time() + 86400 -- 24 Hours
        }
        pcall(function()
            WriteFile(SaveFileName, HttpService:JSONEncode(data))
        end)
    end
end

if IsKeySavedValid() then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/teddyhubdev/diepvy/refs/heads/main/TeddyHub.lua"))()
    return
end

