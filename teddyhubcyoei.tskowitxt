----------------------------------------------------
-- MODERN NOTIFICATION BANNER
----------------------------------------------------

local NotificationFrame = Instance.new("Frame")
NotificationFrame.Name = "NotificationFrame"
NotificationFrame.Parent = MainFrame
NotificationFrame.Position = UDim2.new(0.08, 0, 1, 10)
NotificationFrame.Size = UDim2.new(0.84, 0, 0, 32)
NotificationFrame.BackgroundColor3 = Color3.fromRGB(35, 25, 45)
NotificationFrame.BorderSizePixel = 0

local NotifCorner = Instance.new("UICorner")
NotifCorner.CornerRadius = UDim.new(0, 8)
NotifCorner.Parent = NotificationFrame

local NotifStroke = Instance.new("UIStroke")
NotifStroke.Parent = NotificationFrame
NotifStroke.Thickness = 1.2
NotifStroke.Transparency = 0.2

local StatusLabel = Instance.new("TextLabel")
StatusLabel.Parent = NotificationFrame
StatusLabel.BackgroundTransparency = 1
StatusLabel.Size = UDim2.new(1, 0, 1, 0)
StatusLabel.Font = Enum.Font.GothamMedium
StatusLabel.Text = ""
StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
StatusLabel.TextSize = 12

local function ShowNotification(text, state)
    StatusLabel.Text = text
    
    if state == "Error" then
        NotificationFrame.BackgroundColor3 = Color3.fromRGB(45, 18, 28)
        NotifStroke.Color = Color3.fromRGB(255, 70, 90)
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 120)
    elseif state == "Success" then
        NotificationFrame.BackgroundColor3 = Color3.fromRGB(18, 45, 30)
        NotifStroke.Color = Color3.fromRGB(70, 255, 140)
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 160)
    elseif state == "Info" then
        NotificationFrame.BackgroundColor3 = Color3.fromRGB(22, 35, 55)
        NotifStroke.Color = Color3.fromRGB(80, 160, 255)
        StatusLabel.TextColor3 = Color3.fromRGB(130, 200, 255)
    end

    TweenService:Create(NotificationFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.08, 0, 0.83, 0)
    }):Play()

    if state ~= "Success" then
        task.spawn(function()
            task.wait(2.5)
            TweenService:Create(NotificationFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Position = UDim2.new(0.08, 0, 1, 10)
            }):Play()
        end)
    end
end

----------------------------------------------------
-- INTERACTION & LOGIC
----------------------------------------------------

-- Hover Effects
GetKeyBtn.MouseEnter:Connect(function()
    TweenService:Create(GetKeyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(52, 38, 80)}):Play()
end)
GetKeyBtn.MouseLeave:Connect(function()
    TweenService:Create(GetKeyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(38, 28, 58)}):Play()
end)

CheckKeyBtn.MouseEnter:Connect(function()
    TweenService:Create(CheckKeyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(150, 65, 250)}):Play()
end)
CheckKeyBtn.MouseLeave:Connect(function()
    TweenService:Create(CheckKeyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(130, 50, 225)}):Play()
end)

-- Shake Animation
local function ShakeUI()
    local originalPos = UDim2.new(0.5, 0, 0.5, 0)
    local tweenInfo = TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    
    local shakeOffsets = {
        UDim2.new(0.5, -14, 0.5, 0),
        UDim2.new(0.5, 14, 0.5, 0),
        UDim2.new(0.5, -9, 0.5, 0),
        UDim2.new(0.5, 9, 0.5, 0),
        UDim2.new(0.5, -4, 0.5, 0),
        UDim2.new(0.5, 4, 0.5, 0),
        originalPos
    }

    task.spawn(function()
        for _, offset in ipairs(shakeOffsets) do
            local tween = TweenService:Create(MainFrame, tweenInfo, {Position = offset})
            tween:Play()
            tween.Completed:Wait()
        end
    end)
end

-- Get Key Click
GetKeyBtn.MouseButton1Click:Connect(function()
    if SetClipboard then
        SetClipboard(KeyLink)
        ShowNotification("Key link copied to clipboard!", "Info")
    else
        ShowNotification("Failed to copy link automatically!", "Error")
    end
end)

-- Check Key Click
CheckKeyBtn.MouseButton1Click:Connect(function()
    -- Loại bỏ khoảng trắng thừa ở đầu/cuối key người dùng dán vào
    local cleanInputKey = string.gsub(TextBox.Text, "^%s*(.-)%s*$", "%1")
    
    if cleanInputKey == CorrectKey then
        ShowNotification("Correct Key! Loading script...", "Success")
        
        SaveKeyData()
        
        TweenService:Create(MainFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        TweenService:Create(MainStroke, TweenInfo.new(0.5), {Transparency = 1}):Play()
        
        task.wait(0.6)
        ScreenGui:Destroy()
        
        loadstring(game:HttpGet("https://raw.githubusercontent.com/teddyhubdev/diepvy/refs/heads/main/TeddyHub.lua"))()
    else
        ShowNotification("Invalid Key! Please try again.", "Error")
        TextBox.Text = ""
        ShakeUI()
    end
end)
